# GAAN Backend Environment Variables
PORT=4000
NODE_ENV=development

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Note: Service role key is ONLY used in backend server operations, NEVER exposed to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Client CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
